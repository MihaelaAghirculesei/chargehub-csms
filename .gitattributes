# Normalize all text files to LF in the repository and in the working tree,
# regardless of the local core.autocrlf setting.
* text=auto eol=lf

# Windows batch scripts break when run with LF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary

# The official OCPP JSON schemas are kept byte for byte as published (CC BY-ND 4.0).
ocpp-protocol/src/main/resources/ocpp16/schemas/*.json -text
